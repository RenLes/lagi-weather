# Lagi Weather Guardian — Environment Variables
# Copy this to .env and fill in your values

# Groq LLM API key (free at console.groq.com)
GROQ_API_KEY=

# Secret for signing auth tokens (auto-generated if not set)
LAGI_SIGNUP_SECRET=

# Resend API key for email verification (free at resend.com)
RESEND_API_KEY=

# Email address to send verification codes from
RESEND_FROM_EMAIL=lagi@renles.com

# Optional: NOAA CDO token for historical data (free at ncdc.noaa.gov)
NOAA_CDO_TOKEN=
