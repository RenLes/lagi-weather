# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Model artifacts (large non-LFS files)
output/model-*
output/*.bin
output/*.pt
checkpoints/

# Data (add your own CSVs)
data/*.csv

# Runtime data — never commit (PII or rolling logs)
data/users.jsonl
data/predictions_log.jsonl
data/actuals_log.jsonl
data/performance_log.jsonl
data/cache/

# Logs (keep training log, ignore others)
logs/*.log
!logs/nohup_training_v2.log
*.log.gz

# Databases / local state
*.sqlite
*.sqlite3
*.db

# Environment & secrets — defensive catch-all
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.cer
*.crt
secrets/
GoogleService-Info.plist

# Vercel
.vercel
.vercel/
.env.prod
.env.local
.env.development

# Node / JS (in case of future frontend additions)
node_modules/
.next/
.nuxt/

# IDE / editor noise
.vscode/
.idea/
*.iml
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db
desktop.ini
